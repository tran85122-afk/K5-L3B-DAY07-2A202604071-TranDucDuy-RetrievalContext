# PostgreSQL + pgvector from Day 6 (Docker Compose port 55433)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:55433/<DB_NAME>

# Embedding provider (must match Day 6 index: gemini-embedding-001, 768 dims)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_PER_MINUTE=100

# LLM / Embedding API keys (set your own key in .env; never commit .env)
GEMINI_API_KEY=
AGENT_LLM_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENROUTER_API_KEY=
